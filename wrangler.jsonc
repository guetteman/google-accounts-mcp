{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "google-accounts-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  // Each deploy sets these with `wrangler secret put`; no value lives in the repository.
  "secrets": {
    "required": ["OWNER_EMAIL", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"],
  },
  // No database_id: the deploy's own configuration adds it (#7). Until then, local D1 state
  // is keyed by the binding name, and adding an ID later starts a new, empty local database.
  "d1_databases": [{ "binding": "DB" }],
  "observability": { "enabled": true },
}
