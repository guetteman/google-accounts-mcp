{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "@cloudflare/vitest-plugin/types"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "test", "worker-configuration.d.ts", "vite.config.ts"]
}
